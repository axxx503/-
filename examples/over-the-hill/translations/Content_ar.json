{
  "vehicleUpgrades/Engine/description": "يزيد من قوة المحرك للوصول إلى سرعة قصوى أعلى.",
  "vehicleUpgrades/Engine/Stage2/name": "المحرك - المرحلة 2",
  "vehicleUpgrades/Engine/Stage3/name": "المحرك - المرحلة 3",
  "vehicleUpgrades/WaterResistance/stage2/name": "مقاومة الماء - المرحلة 2",
  "vehicleUpgrades/WaterResistance/description": "يزيد من عمق المياه والمدة التي يتحملها المحرك قبل أن يغرق.",
  "vehicle/RustOx/name": "الثور الصدئ (Das Rust Ox)",
  "vehicle/RustOx/description": "قضى «الثور الصدئ» حياته الأولى في نقل الركاب والبضائع بينما رفض محرك الديزل الخاص به التقاعد تماماً. وبعد تقاعده، أضاف إليه أحدهم سريراً وخزائن وإبريق قهوة ورفاً صُمم خصيصاً للحفاظ على البسكويت سليماً في الطرق الوعرة.",
  "vehicle/TrailBurner/name": "حارق المسارات (The Trail Burner)",
  "vehicle/TrailBurner/description": "أخذ أحدهم شاحنة بيك آب كبيرة الحجم، وقصّرها بشكل كبير، ونقل مساحة التحميل إلى الداخل وجعل معظم السقف قابلاً للإزالة. النتيجة منحت «حارق المسارات» مساحة واسعة لمعدات التخييم، وترمس كبير، ومؤونة تكفي لعدة أيام من الشطائر.",
  "vehicle/Bull/name": "الثور الإصدار 1 (The Bull v1)",
  "vehicle/Bull/description": "داخل المصنع، كان «الثور الإصدار 1» يُعرف ببساطة بلقب «الأعظم» بفضل قدرته على اجتياز أي تضاريس. ويبدو أن ذلك لم يكن كافياً، لذا قدّم كتالوج الملحقات كل شيء من الأوناش وكاسحات الثلوج إلى أجهزة الراديو والمعدات الآلية، مما أتاح لمالكيه تحويله إلى أي شيء تقريباً باستثناء سيارة عادية.",
  "vehicle/Protector/name": "الحامي (The Protector)",
  "vehicle/Protector/description": "وصلت التطورات في تكنولوجيا أكواخ الحدائق أخيراً إلى «الحامي»، فجلبت معها نوابض لولبية، وتنجيداً محسناً، وقليلاً من الراحة الإضافية. لطالما اشتكى المزارعون من أن التوقف لشرب الشاي يضر بالإنتاجية، لذا زاد المصنع من سعة تسخين المياه على متن المركبة تبعاً لذلك.",
  "vehicle/DingDing/name": "الرنان (The Ding)",
  "vehicle/DingDing/description": "كان «الرنان» ثمرة النقص الكبير في المساطر عام 1960، حيث كانت المكابس الجديدة تطبع ألواح الهيكل المستقيمة بسرعة تكفي لإرسالها إلى كل مكان تقريباً. من نقل التوفو في اليابان إلى الحطب في جبال الألب، وُلدت أيقونة خالدة.",
  "vehicle/Burro/name": "البغل الجبلي (The Burro)",
  "vehicle/Burro/description": "خذ متسلق جبال أثبت كفاءته، ومدّده قليلاً وامنحه مساحة لحمل الأمتعة. حصل «البغل الجبلي» على هيكل أطول ونوابض ورقية خلفية مقوّاة للأحمال الثقيلة، مما جعله سعيداً بنفس القدر بحمل الأدوات أو علف الماشية أو كميات غير منطقية من المرطبات.",
  "vehicle/Brick/name": "الطوبة (The Brick)",
  "vehicle/Brick/description": "عندما حان وقت تحديث «الرنان»، أُعطي المهندسون تعليمتين اثنتين: اجعلوه أكثر راحة، ولا تجعلوه أسوأ. حصلت «الطوبة» على زجاج أمامي منحنٍ أثار حماسة كبيرة في المصنع، إلى جانب مساحة إضافية ومقاعد أجمل. أما من الأسفل، فظلت ملتزمة بعناد بكونها طوبة صلبة.",
  "vehicle/BlastWagon/name": "عربة العصف (The Blast Wagon)",
  "vehicle/BlastWagon/description": "استخدم صندوق التحميل في «عربة العصف» أرضية من الخشب الصلب المدعّم بشرائط فولاذية، ويُقال إن ذلك حدث بعد أن استعار أحدهم بالخطأ أخشاباً كانت مخصصة لكوخ فاخر. لم يشتكِ أحد، لأنها أثبتت أنها مكان ممتاز لإلقاء الأدوات والأخشاب وكل شيء آخر.",
  "vehicle/Trailrat/name": "جرذ المسارات (The Trailrat)",
  "vehicle/Trailrat/description": "بدأ «جرذ المسارات» بطلب بسيط: استبدال الحصان. استجاب المهندسون بألواح هيكل قابلة للإزالة، ودفع رباعي، ومحرك صُنع أساساً عن طريق شطر محرك أكبر إلى نصفين. وبطريقة ما، نجح كل هذا معاً.",
  "vehicle/Mammoth/name": "الماموث (Das Mammoth)",
  "vehicle/Mammoth/description": "مزيج بين الجرار والشاحنة وصندوق الأدوات؛ كان «الماموث» قادراً على النقل والقطر والحرث وتشغيل الآلات والزحف ببطء يكاد يكون أبطأ من المشي. ومع وجود ما يكفي من الملحقات، توقف المالكون عن السؤال عما يمكنه فعله وبدؤوا يتساءلون عما لا يمكنه فعله.",
  "vehicle/Woodman/name": "الحطّاب (The Woodman)",
  "vehicle/Woodman/description": "في وقتٍ كان يُتوقع فيه من مركبات الدفع الرباعي أن تسير مثل المعدات الزراعية، ظهر «الحطّاب» بمقاعد مريحة وصانعة قهوة وفكرة ثورية مفادها أن الركاب قد يستمتعون بالرحلة أيضاً. وبطريقة ما، نجح في ذلك دون أن ينسى كيف يخوض في الوحل.",
  "vehicle/GrandWoodman/name": "الحطّاب الكبير (The Grand Woodman)",
  "vehicle/GrandWoodman/description": "في نهاية المطاف، كبر «الحطّاب» وارتدى حلة أبهى ليصبح «الحطّاب الكبير». أُضيفت السجاجيد والمقاعد الأكثر نعومة والزخارف الأنيقة على مر السنين، مع مساحة تخزين مخصصة للشوكولاتة الساخنة وحلوى الخطمي، بينما استمر من الأسفل بعناد في استخدام معظم الآليات القديمة ذاتها.",
  "vehicle/Timberbox/name": "الصندوق الخشبي (The Timberbox)",
  "vehicle/Timberbox/description": "لم يُصنع سوى عدد قليل جداً من مركبات «الصندوق الخشبي»، حيث جمعت بين هيكل دفع رباعي ثقيل ومقصورة ضخمة مشيدة من الخشب. بل إن نجاراً متحمساً زوّد إحداها بغرفة ساونا صغيرة في الخلف، مما أسعد الركاب أثناء انتظار الإنقاذ حين يعلقون.",
